<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross platform command line front end: Windows, Linux, macOS (x64 and arm64). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>binview</AssemblyName>
    <RootNamespace>BinaryViewer.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\BinaryViewer.Core.csproj" />
  </ItemGroup>

</Project>
